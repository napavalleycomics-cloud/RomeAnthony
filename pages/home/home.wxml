<!-- Home Page - Fridge View -->
<view class="home-container">
  <!-- Header -->
  <view class="header">
    <text class="heading-large">Available in fridge</text>
    <view class="btn-icon" bindtap="onSettingsTap">
      <text>⚙️</text>
    </view>
  </view>

  <!-- Quick Actions Bar -->
  <view class="quick-items" wx:if="{{fridgeItems.length > 0}}">
    <scroll-view scroll-x="true" class="quick-scroll">
      <view class="quick-item-list">
        <view
          class="quick-item {{item.freshness === 'expired' ? 'expired' : item.freshness === 'expiring' ? 'expiring' : ''}}"
          wx:for="{{fridgeItems}}"
          wx:key="id"
          bindtap="onQuickItemTap"
          data-item="{{item}}"
        >
          <view class="quick-item-content">
            <text class="quick-item-icon">{{item.icon}}</text>
            <text class="quick-item-name">{{item.name}}</text>
            <view
              class="btn-icon btn-remove quick-remove"
              catchtap="onRemoveItem"
              data-id="{{item.id}}"
              aria-label="Remove {{item.name}}"
            >
              <text>✕</text>
            </view>
          </view>
          <view class="quick-item-quantity" wx:if="{{item.quantity > 1}}">
            {{item.quantity}}
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{fridgeItems.length === 0}}">
    <text class="empty-icon">🍽️</text>
    <text class="empty-text">Your fridge is empty</text>
    <text class="text-caption">Tap the + button below to add items</text>
  </view>

  <!-- Visual Fridge Representation -->
  <view class="fridge-visual" wx:if="{{fridgeItems.length > 0}}">
    <view class="fridge-container">
      <!-- Fridge Top -->
      <view class="fridge-top"></view>

      <!-- Fridge Body -->
      <view class="fridge-body">
        <!-- Freezer Section -->
        <view class="fridge-section freezer">
          <view class="section-label">Freezer</view>
          <view class="section-items">
            <view
              class="fridge-item"
              wx:for="{{freezerItems}}"
              wx:key="id"
            >
              <text class="fridge-item-icon">{{item.icon}}</text>
            </view>
          </view>
        </view>

        <!-- Top Shelf -->
        <view class="fridge-section shelf">
          <view class="section-items">
            <view
              class="fridge-item"
              wx:for="{{topShelfItems}}"
              wx:key="id"
            >
              <text class="fridge-item-icon">{{item.icon}}</text>
            </view>
          </view>
        </view>

        <!-- Middle Shelf -->
        <view class="fridge-section shelf">
          <view class="section-items">
            <view
              class="fridge-item"
              wx:for="{{middleShelfItems}}"
              wx:key="id"
            >
              <text class="fridge-item-icon">{{item.icon}}</text>
            </view>
          </view>
        </view>

        <!-- Bottom Shelf -->
        <view class="fridge-section shelf">
          <view class="section-items">
            <view
              class="fridge-item"
              wx:for="{{bottomShelfItems}}"
              wx:key="id"
            >
              <text class="fridge-item-icon">{{item.icon}}</text>
            </view>
          </view>
        </view>

        <!-- Drawer Section -->
        <view class="fridge-section drawer">
          <view class="section-items">
            <view
              class="fridge-item"
              wx:for="{{drawerItems}}"
              wx:key="id"
            >
              <text class="fridge-item-icon">{{item.icon}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Expiring Soon Alert -->
  <view class="expiring-alert" wx:if="{{expiringItems.length > 0}}">
    <view class="alert-header">
      <text class="alert-icon">⚠️</text>
      <text class="alert-title">Items expiring soon</text>
    </view>
    <view class="alert-items">
      <view class="alert-item" wx:for="{{expiringItems}}" wx:key="id">
        <text class="alert-item-icon">{{item.icon}}</text>
        <view class="alert-item-info">
          <text class="alert-item-name">{{item.name}}</text>
          <text class="alert-item-expiry">{{item.expiryText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Action Buttons -->
  <view class="action-buttons">
    <view class="btn btn-primary full-width" bindtap="onAddItemsTap">
      <text class="btn-icon-inline">➕</text>
      <text>Add Items to Fridge</text>
    </view>
    <view class="btn btn-secondary full-width" bindtap="onRecipesTap" wx:if="{{fridgeItems.length > 0}}">
      <text class="btn-icon-inline">👨‍🍳</text>
      <text>See Recipe Ideas</text>
    </view>
  </view>
</view>
