      </view>
    </view>
  </scroll-view>

  <!-- Bottom Action Button -->
  <view class="bottom-action" wx:if="{{itemsAdded > 0}}">
    <view class="btn btn-primary action-btn" bindtap="onViewFridge">
      <text>View Fridge ({{itemsAdded}} items added)</text>
    </view>
  </view>
</view>
