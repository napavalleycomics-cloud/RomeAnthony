<!-- Add Items Page -->
<view class="add-items-container">
  <!-- Search Bar -->
  <view class="search-container">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="Search items"
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchQuery}}" bindtap="onClearSearch">
        <text>✕</text>
      </view>
    </view>
  </view>

  <!-- Search Results -->
  <view class="search-results" wx:if="{{searchQuery && searchResults.length > 0}}">
    <text class="section-title">Search Results</text>
    <view class="item-grid">
      <view
        class="item-card {{item.inFridge ? 'in-fridge' : ''}}"
        wx:for="{{searchResults}}"
        wx:key="id"
        bindtap="onAddItem"
        data-item="{{item}}"
      >
        <text class="item-icon">{{item.icon}}</text>
        <text class="item-name">{{item.name}}</text>
        <view class="btn-icon btn-add add-button" wx:if="{{!item.inFridge}}">
          <text>➕</text>
        </view>
        <view class="btn-icon btn-success add-button" wx:if="{{item.inFridge}}">
          <text>✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- No Search Results -->
  <view class="empty-state" wx:if="{{searchQuery && searchResults.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">No items found</text>
    <text class="text-caption">Try a different search term</text>
  </view>

  <!-- Categories (shown when not searching) -->
  <scroll-view scroll-y="true" class="categories-scroll" wx:if="{{!searchQuery}}">
    <!-- Popular Items -->
    <view class="category-section">
      <text class="section-title">Popular items</text>
      <view class="item-grid">
        <view
          class="item-card {{item.inFridge ? 'in-fridge' : ''}}"
          wx:for="{{popularItems}}"
          wx:key="id"
          bindtap="onAddItem"
          data-item="{{item}}"
        >
          <text class="item-icon">{{item.icon}}</text>
          <text class="item-name">{{item.name}}</text>
          <view class="btn-icon btn-add add-button" wx:if="{{!item.inFridge}}">
            <text>➕</text>
          </view>
          <view class="btn-icon btn-success add-button" wx:if="{{item.inFridge}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Drinks -->
    <view class="category-section">
      <text class="section-title">Drinks</text>
      <view class="item-grid">
        <view
          class="item-card {{item.inFridge ? 'in-fridge' : ''}}"
