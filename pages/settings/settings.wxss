/* Settings Page Styles */
.settings-container {
  min-height: 100vh;
  background-color: #FFFEF9;
}

.header {
  padding: 20px;
  background-color: #E6E1F5;
}

.heading-large {
  font-size: 28px;
  font-weight: 700;
  color: #333333;
}

.settings-scroll {
  height: calc(100vh - 80px);
  padding-bottom: 60px;
}

/* App Logo */
.app-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

.logo-icon {
  font-size: 80px;
  margin-bottom: 12px;
}

.logo-text {
  font-size: 24px;
  font-weight: 700;
  color: #333333;
  margin-bottom: 4px;
}

.logo-version {
  font-size: 14px;
  color: #666666;
}

/* Settings Section */
.settings-section {
  margin-bottom: 24px;
}

.section-title {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #666666;
  padding: 16px 20px 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Setting Item */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background-color: #FFFFFF;
  border-bottom: 1px solid #F0F0F0;
  min-height: 68px;
}

.setting-item:first-of-type {
  border-top: 1px solid #F0F0F0;
}

.setting-item.clickable:active {
  background-color: #F5F5F5;
}

.setting-item.danger {
  background-color: #FFEBEE;
}

.setting-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16px;
}

.setting-label {
  font-size: 16px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4px;
}

.setting-label.danger-text {
  color: #F44336;
}

.setting-description {
  font-size: 14px;
  color: #666666;
  line-height: 1.4;
}

.setting-value {
  font-size: 16px;
  font-weight: 600;
  color: #9B8AC4;
}

.setting-arrow {
  font-size: 20px;
  color: #CCCCCC;
}

/* Picker */
.picker-value {
  font-size: 16px;
  font-weight: 600;
  color: #9B8AC4;
  padding: 8px 12px;
  background-color: #F5F5F5;
  border-radius: 8px;
}

/* About Content */
.about-content {
  padding: 16px 20px;
  background-color: #FFFFFF;
  border-top: 1px solid #F0F0F0;
  border-bottom: 1px solid #F0F0F0;
}

.about-text {
  display: block;
  font-size: 15px;
  line-height: 1.6;
  color: #666666;
  margin-bottom: 16px;
}

.about-text:last-child {
  margin-bottom: 0;
  text-align: center;
  margin-top: 24px;
  font-size: 16px;
  color: #9B8AC4;
}
