<!-- Recipes Page -->
<view class="recipes-container">
  <!-- Header -->
  <view class="header">
    <text class="heading-large">Recipe Ideas</text>
    <text class="header-subtitle">Based on what's in your fridge</text>
  </view>

  <!-- Empty Fridge State -->
  <view class="empty-state" wx:if="{{fridgeItems.length === 0}}">
    <text class="empty-icon">🍳</text>
    <text class="empty-text">Add items to your fridge first</text>
    <text class="text-caption">We'll suggest recipes based on what you have</text>
    <view class="btn btn-primary" bindtap="onAddItemsTap" style="margin-top: 20px;">
      <text>Add Items</text>
    </view>
  </view>

  <!-- Recipes List -->
  <scroll-view scroll-y="true" class="recipes-scroll" wx:if="{{fridgeItems.length > 0}}">
    <!-- Can Make Now -->
    <view class="recipe-section" wx:if="{{canMakeRecipes.length > 0}}">
      <text class="section-title">✨ You can make these now!</text>
      <view class="recipe-list">
        <view
          class="recipe-card can-make"
          wx:for="{{canMakeRecipes}}"
          wx:key="id"
          bindtap="onRecipeTap"
          data-recipe="{{item}}"
        >
          <view class="recipe-header">
            <text class="recipe-icon">{{item.icon}}</text>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="recipe-difficulty">{{item.difficulty}}</text>
                <text class="recipe-time">⏱ {{item.time}}</text>
              </view>
            </view>
            <view class="recipe-badge badge-can-make">
              <text>Ready!</text>
            </view>
          </view>
          <view class="recipe-match">
            <text class="match-text">All ingredients available</text>
            <text class="match-optional" wx:if="{{item.optionalMatches > 0}}">
              + {{item.optionalMatches}} optional
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- Almost There -->
    <view class="recipe-section" wx:if="{{almostRecipes.length > 0}}">
      <text class="section-title">🔶 Almost there</text>
      <view class="recipe-list">
        <view
          class="recipe-card almost"
          wx:for="{{almostRecipes}}"
          wx:key="id"
          bindtap="onRecipeTap"
          data-recipe="{{item}}"
        >
          <view class="recipe-header">
            <text class="recipe-icon">{{item.icon}}</text>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="recipe-difficulty">{{item.difficulty}}</text>
                <text class="recipe-time">⏱ {{item.time}}</text>
              </view>
            </view>
            <view class="recipe-badge badge-almost">
              <text>{{item.requiredMatches}}/{{item.totalRequired}}</text>
            </view>
          </view>
          <view class="recipe-match">
            <text class="match-text">Missing: {{item.missingText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Other Recipes -->
    <view class="recipe-section" wx:if="{{otherRecipes.length > 0}}">
      <text class="section-title">💡 More ideas</text>
      <view class="recipe-list">
        <view
          class="recipe-card"
          wx:for="{{otherRecipes}}"
          wx:key="id"
          bindtap="onRecipeTap"
          data-recipe="{{item}}"
        >
          <view class="recipe-header">
            <text class="recipe-icon">{{item.icon}}</text>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="recipe-difficulty">{{item.difficulty}}</text>
                <text class="recipe-time">⏱ {{item.time}}</text>
              </view>
            </view>
          </view>
          <view class="recipe-match">
            <text class="match-text">{{item.matchPercentage}}% match</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- Recipe Detail Modal -->
<view class="modal" wx:if="{{showRecipeDetail}}" bindtap="onCloseModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">{{selectedRecipe.name}}</text>
      <view class="btn-icon" bindtap="onCloseModal">
        <text>✕</text>
      </view>
    </view>

    <view class="modal-body">
      <view class="recipe-detail-icon">
        <text>{{selectedRecipe.icon}}</text>
      </view>

      <view class="recipe-detail-meta">
        <view class="meta-item">
          <text class="meta-label">Difficulty</text>
          <text class="meta-value">{{selectedRecipe.difficulty}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">Time</text>
          <text class="meta-value">{{selectedRecipe.time}}</text>
        </view>
      </view>

      <!-- Ingredients -->
      <view class="ingredients-section">
        <text class="detail-section-title">Required Ingredients</text>
        <view class="ingredient-list">
          <view
            class="ingredient-item {{item.available ? 'available' : 'missing'}}"
            wx:for="{{selectedRecipe.requiredIngredientsList}}"
            wx:key="id"
          >
            <text class="ingredient-icon">{{item.available ? '✓' : '✕'}}</text>
            <text class="ingredient-name">{{item.name}}</text>
          </view>
        </view>

        <text class="detail-section-title" wx:if="{{selectedRecipe.optionalIngredientsList.length > 0}}">Optional Ingredients</text>
        <view class="ingredient-list" wx:if="{{selectedRecipe.optionalIngredientsList.length > 0}}">
          <view
            class="ingredient-item optional {{item.available ? 'available' : ''}}"
            wx:for="{{selectedRecipe.optionalIngredientsList}}"
            wx:key="id"
          >
            <text class="ingredient-icon">{{item.available ? '✓' : '○'}}</text>
            <text class="ingredient-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- Instructions -->
      <view class="instructions-section">
        <text class="detail-section-title">Instructions</text>
        <view class="instruction-list">
          <view class="instruction-item" wx:for="{{selectedRecipe.instructions}}" wx:key="*this">
            <view class="instruction-number">{{index + 1}}</view>
            <text class="instruction-text">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- Action Button -->
      <view class="modal-action" wx:if="{{!selectedRecipe.canMake}}">
        <view class="btn btn-primary full-width" bindtap="onAddMissingItems">
          <text>Add Missing Items</text>
        </view>
      </view>
    </view>
  </view>
</view>
